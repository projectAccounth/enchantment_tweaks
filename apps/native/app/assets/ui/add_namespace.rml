<rml>
<head>
	<title>Add namespace</title>
	<link type="text/rcss" href="selector.rcss"/>
</head>
<body class="modal" data-model="selector" data-class-dark="dark_mode" data-event-click="dialog_backdrop">
	<div class="dialog">
		<h2>Add namespace</h2>

		<div class="field">
			<label>Display name</label>
			<input type="text" id="ns-label" maxlength="32" data-value="ns_form.label"/>
		</div>

		<div class="field">
			<label>Namespace ID</label>
			<input type="text" id="ns-id" maxlength="32" data-value="ns_form.id"/>
		</div>
		<p class="field-hint">Usually the mod ID, like create. Lowercase letters, numbers, underscores, dots and dashes.</p>

		<p class="err" data-if="ns_form.error != ''">{{ ns_form.error }}</p>

		<div class="dlg-actions">
			<button class="pill" data-event-click="close_dialog"><span>Cancel</span></button>
			<button class="pill accent" data-event-click="submit_ns"><span>Add namespace</span></button>
		</div>
	</div>
</body>
</rml>
