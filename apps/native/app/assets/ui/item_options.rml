<rml>
<head>
	<title>Outline and thickness</title>
	<link type="text/rcss" href="selector.rcss"/>
</head>
<body class="modal" data-model="selector" data-class-dark="dark_mode" data-event-click="dialog_backdrop">
	<div class="dialog">
		<h2>{{ override_form.title }}</h2>
		<p class="field-hint">Applies to the selected item or group only. Reset puts the project's values back. Hover a name for details.</p>

		<div class="field">
			<label data-event-mouseover="show_tip('thickness')" data-event-mouseout="hide_tip">Thickness <span class="opt">(px)</span></label>
			<input type="text" id="set-thickness" maxlength="8" data-value="override_form.thickness"/>
			<p class="field-hint">Depth of the item's sprite. 1 is the default.</p>
		</div>
		<div class="field">
			<label data-event-mouseover="show_tip('outline_size')" data-event-mouseout="hide_tip">Outline size <span class="opt">(px, 0 = none)</span></label>
			<input type="text" id="set-outline" maxlength="8" data-value="override_form.outline_size"/>
			<p class="field-hint">Width of the outline around the item. 0 gives no outline.</p>
		</div>
		<div class="field">
			<label data-event-mouseover="show_tip('outline_color')" data-event-mouseout="hide_tip">Outline color <span class="opt">(hex)</span></label>
			<input type="text" id="set-color" maxlength="6" data-value="override_form.outline_color"/>
			<p class="field-hint">Six hex digits, rrggbb. ffffff is white.</p>
		</div>
		<div class="field">
			<label data-event-mouseover="show_tip('unenchanted')" data-event-mouseout="hide_tip">Unenchanted outlines</label>
			<button class="pill toggle" data-class-on="override_form.unenchanted" data-event-click="toggle_override('unenchanted')"><span>{{ override_form.unenchanted ? 'On' : 'Off' }}</span></button>
			<p class="field-hint">Also outlines items without an enchantment. When off, they keep their original model.</p>
		</div>
		<div class="field">
			<label data-event-mouseover="show_tip('unshaded')" data-event-mouseout="hide_tip">Unshaded unenchanted models</label>
			<button class="pill toggle" data-class-on="override_form.unshaded" data-event-click="toggle_override('unshaded')"><span>{{ override_form.unshaded ? 'On' : 'Off' }}</span></button>
			<p class="field-hint">Needs Unenchanted outlines. Enchanted models are always unshaded.</p>
		</div>
		<div class="field">
			<label data-event-mouseover="show_tip('merge')" data-event-mouseout="hide_tip">Merge runs <span class="opt">(generated items only)</span></label>
			<button class="pill toggle" data-class-on="override_form.merge" data-event-click="toggle_override('merge')"><span>{{ override_form.merge ? 'On' : 'Off' }}</span></button>
			<p class="field-hint">Smaller file, may change the look in some packs. Custom 3D models are never merged.</p>
		</div>

		<p class="err" data-if="override_form.error != ''">{{ override_form.error }}</p>

		<div class="dlg-actions">
			<button class="pill" data-event-click="item_options_reset"><span>Reset to project</span></button>
			<button class="pill" data-event-click="close_dialog"><span>Cancel</span></button>
			<button class="pill accent" data-event-click="item_options_submit"><span>Save</span></button>
		</div>
	</div>
	<div class="tooltip" data-if="tip_visible" data-style-left="tip_x" data-style-top="tip_y">{{ tip_text }}</div>
</body>
</rml>
