<rml>
<head>
	<title>Enchantment Tweaks</title>
	<link type="text/rcss" href="selector.rcss"/>
</head>
<body class="app" data-model="selector" data-class-dark="dark_mode" data-event-click="body_click">

	<div class="topbar">
		<button class="brand" data-event-click="open_link('home')"><div class="logo-art"></div></button>
		<div class="tag"><span>Selector</span></div>
	</div>

	<div class="menubar">
		<div class="menu-group">
			<button class="menu-title" data-class-open="menu_open == 'file'" data-event-click="toggle_menu('file')"><span>File</span></button>
			<div class="menu-drop" data-if="menu_open == 'file'">
				<div data-for="m : file_menu">
					<button class="menu-item" data-if="!m.separator" data-class-disabled="!m.enabled" data-attrif-disabled="!m.enabled" data-event-click="menu_action(m.action, m.arg)"><span>{{ m.label }}</span><span class="kbd">{{ m.shortcut }}</span></button>
					<div class="menu-sep" data-if="m.separator"></div>
				</div>
			</div>
		</div>
		<button class="menu-title" data-event-click="open_app_settings_button"><span>Settings</span></button>
		<button class="menu-title" data-class-disabled="!has_project" data-event-click="open_project_settings_button"><span>Project settings</span></button>
		<span class="status">{{ status_text }}</span>
	</div>

	<div class="shell">

		<!-- ============================ sidebar ============================ -->
		<div class="sidebar">

			<div class="panel">
				<button class="head" data-event-click="toggle_collapsed('side:versions')">
					<div class="ico chev" data-class-collapsed="versions_collapsed"></div>
					<span class="t">Selected Versions</span>
				</button>
				<div class="panel-body" data-if="!versions_collapsed">
					<div class="vers">
						<button class="pill ver" data-for="v : versions" data-class-on="v.on" data-event-click="toggle_version(v.label)">
							<div class="ico sm check-ok" data-if="v.on"></div>
							<span>{{ v.label }}</span>
						</button>
					</div>
					<button class="pill more-versions" data-event-click="menu_action('open_download', '')"><span>Download more versions...</span></button>
				</div>
			</div>

			<div class="panel">
				<button class="head" data-event-click="toggle_collapsed('side:created')">
					<div class="ico chev" data-class-collapsed="created_collapsed"></div>
					<span class="t">Created Items</span>
				</button>
				<div class="panel-body" data-if="!created_collapsed">
					<div class="subs">
						<p class="hint" data-if="created_groups.size == 0">Nothing yet. Select an item to add it to your pack.</p>
						<div class="sub" data-for="g : created_groups">
							<button class="head" data-event-click="toggle_collapsed(g.collapse_key)">
								<div class="ico chev" data-class-collapsed="!g.open"></div>
								<span class="t">{{ g.label }}</span>
								<span class="ns">{{ g.ns_id }}</span>
							</button>
							<div class="chips" data-if="g.open">
								<button class="pill chip" data-for="c : g.chips" data-event-click="remove_item(c.key)">
									<div class="ico sm x"></div>
									<span class="label">{{ c.name }}</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="side-rule"></div>
			<div class="actions">
				<div class="pill count"><span>{{ created_label }}</span></div>
				<button class="pill accent" data-class-disabled="!can_download" data-event-click="download"><span>Download Pack</span></button>
			</div>
			<p class="hint" data-if="!can_download">{{ download_hint }}</p>
		</div>

		<!-- ============================= catalog ============================= -->
		<div class="main">

			<div class="toolbar">
				<div class="search">
					<div class="ico magnifier"></div>
					<input type="text" id="search" data-value="query" maxlength="64"/>
					<span class="placeholder" data-if="query == ''">Search...</span>
				</div>
				<button class="pill with-icon" data-event-click="open_item_dialog"><div class="ico plus"></div><span>Add Item</span></button>
				<button class="pill with-icon accent" data-event-click="open_ns_dialog"><div class="ico plus"></div><span>Add Namespace</span></button>
			</div>

			<div class="sortrow">
				<button class="pill with-icon sort" data-event-click="toggle_sort_menu">
					<div class="ico chev" data-class-collapsed="!sort_open"></div>
					<span>Sort By</span>
				</button>
				<button class="pill group-toggle" data-event-click="menu_action('cycle_group', '')" data-event-mouseover="show_tip('group')" data-event-mouseout="hide_tip"><span>{{ group_label }}</span></button>
				<div class="menu" data-if="sort_open">
					<button data-for="o : sort_options" data-event-click="set_sort(o.key)">
						<div class="ico check" data-class-off="!o.checked"></div>
						<span>{{ o.label }}</span>
					</button>
				</div>
			</div>

			<div class="grid-spacer" data-style-height="grid_top"></div>
			<div data-for="row : grid_window">
				<div class="sec-head-row" data-if="row.is_header">
					<button class="head sec-head" data-class-open="row.open" data-event-click="toggle_collapsed(row.collapse_key)" data-event-mousedown="context_click(row.collapse_key, 'group')">
						<div class="ico chev" data-class-collapsed="!row.open"></div>
						<span class="t">{{ row.label }}</span>
						<span class="ns">{{ row.ns_id }}</span>
					</button>
					<div class="rule"></div>
				</div>
				<div class="card-row" data-if="row.is_cards">
					<div class="grid">
						<button class="card" data-for="c : row.cards" data-if="c.visible" data-class-selected="c.selected" data-event-click="toggle_item(c.key)" data-event-mousedown="context_click(c.key, 'item')">
							<div class="thumb">
								<img data-attr-src="c.icon"/>
							</div>
							<div class="name">{{ c.name }}</div>
							<div class="id">{{ c.id }}</div>
						</button>
					</div>
				</div>
				<div class="empty-row" data-if="row.is_empty">
					<p class="empty">No items in this namespace yet. Use Add Item to create one.</p>
				</div>
			</div>
			<div class="grid-spacer" data-style-height="grid_bottom"></div>

			<p class="empty" data-if="no_match">{{ no_match_text }}</p>
		</div>
	</div>

	<div class="ctx-menu" data-if="ctx_open" data-style-left="ctx_x" data-style-top="ctx_y">
		<button class="ctx-item" data-for="e : ctx_items" data-class-disabled="!e.enabled" data-attrif-disabled="!e.enabled" data-event-click="ctx_action(e.action)"><span>{{ e.label }}</span></button>
	</div>
	<div class="tooltip" data-if="tip_visible" data-style-left="tip_x" data-style-top="tip_y">{{ tip_text }}</div>
	<div class="busy-overlay" data-if="busy">
		<div class="busy-box"><p class="busy-text">{{ busy_text }}</p></div>
	</div>
	<div class="debug-panel" data-if="debug_visible">
		<p class="debug-text">{{ debug_text }}</p>
	</div>
	<div class="toast-wrap" data-if="toast_visible"><div class="toast"><span>{{ toast_text }}</span></div></div>
</body>
</rml>
